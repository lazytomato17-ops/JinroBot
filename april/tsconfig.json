{
  "compilerOptions": {
    "noImplicitAny": false,
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "discord.js": ["./node_modules/discord.js", "../node_modules/discord.js"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js", "../node_modules/@supabase/supabase-js"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
